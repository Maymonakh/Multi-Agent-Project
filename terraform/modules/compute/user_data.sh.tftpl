#!/bin/bash
# Generated by Terraform. Runs once when the server starts:
# installs Docker, mounts the data disk, writes the settings and starts the application.
set -euxo pipefail
exec > >(tee /var/log/app-bootstrap.log) 2>&1

# ---- 1. Docker and Docker Compose
dnf install -y docker jq
systemctl enable --now docker
mkdir -p /usr/local/lib/docker/cli-plugins
curl -fSL "https://github.com/docker/compose/releases/download/v${compose_version}/docker-compose-linux-x86_64" \
  -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

# ---- 2. Data disk (wait until it is attached, format it only the first time, mount it)
DEVICE=""
for i in $(seq 1 60); do
  for d in /dev/nvme1n1 /dev/xvdf /dev/sdf; do
    if [ -b "$d" ]; then DEVICE="$d"; break; fi
  done
  if [ -n "$DEVICE" ]; then break; fi
  sleep 5
done
if [ -z "$DEVICE" ]; then echo "Data disk was not found"; exit 1; fi

if ! blkid "$DEVICE"; then mkfs -t xfs "$DEVICE"; fi
mkdir -p /opt/app/data
UUID=$(blkid -s UUID -o value "$DEVICE")
grep -q "$UUID" /etc/fstab || echo "UUID=$UUID /opt/app/data xfs defaults,nofail 0 2" >> /etc/fstab
mount -a
mkdir -p /opt/app/data/documents /opt/app/data/reports /opt/app/data/chroma_db /opt/app/data/hf_cache /opt/app/data/redis

# ---- 3. Settings: normal values come from Terraform, secret values from Secrets Manager
cat > /opt/app/.env.base <<'ENVEOF'
${env_lines}
ENVEOF

cat > /opt/app/refresh-env.sh <<'SCRIPT'
#!/bin/bash
set -uo pipefail
cp /opt/app/.env.base /opt/app/.env
if SECRET=$(aws secretsmanager get-secret-value --region ${aws_region} --secret-id ${secret_name} --query SecretString --output text 2>/dev/null); then
  echo "$SECRET" | jq -r 'to_entries[] | "\(.key)=\(.value)"' >> /opt/app/.env
else
  echo "WARNING: the secret ${secret_name} has no value yet (see README)."
fi
chmod 600 /opt/app/.env
SCRIPT

# ---- 4. Same three services as docker-compose.yml in the project
cat > /opt/app/docker-compose.yml <<'COMPOSE'
services:
  redis:
    image: redis:7-alpine
    command: redis-server --appendonly yes
    volumes:
      - /opt/app/data/redis:/data
    restart: unless-stopped

  api:
    image: ${image}
    env_file: /opt/app/.env
    environment:
      REDIS_URL: redis://redis:6379/0
    ports:
      - "8000:8000"
    volumes:
      - /opt/app/data/documents:/app/documents
      - /opt/app/data/reports:/app/reports
      - /opt/app/data/chroma_db:/app/chroma_db
      - /opt/app/data/hf_cache:/root/.cache/huggingface
    depends_on:
      - redis
    restart: unless-stopped

  ui:
    image: ${image}
    command: ["streamlit", "run", "app.py", "--server.port=8501", "--server.address=0.0.0.0"]
    environment:
      API_URL: http://api:8000
      API_KEY: $${API_KEY:-}
    healthcheck:
      disable: true
    ports:
      - "8501:8501"
    depends_on:
      - api
    restart: unless-stopped
COMPOSE

# ---- 5. Deploy script (run it again after pushing a new image)
cat > /opt/app/deploy.sh <<'DEPLOY'
#!/bin/bash
set -euo pipefail
cd /opt/app
/opt/app/refresh-env.sh
aws ecr get-login-password --region ${aws_region} | docker login --username AWS --password-stdin ${ecr_registry}
docker compose pull
docker compose up -d
DEPLOY
chmod +x /opt/app/refresh-env.sh /opt/app/deploy.sh

/opt/app/deploy.sh || echo "First deploy failed: the image is not in the registry yet. Push it, then run /opt/app/deploy.sh"
